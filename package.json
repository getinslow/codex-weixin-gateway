{
  "name": "codex-weixin-gateway",
  "version": "0.4.0",
  "private": true,
  "description": "Standalone Weixin channel gateway backed by a persistent Codex App Server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codex-weixin-gateway": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node test/run.mjs",
    "test:app-server": "node test/live-app-server-smoke.mjs",
    "test:live-turn": "node test/live-app-server-turn.mjs",
    "login": "tsx src/main.ts login",
    "start": "node dist/main.js serve",
    "dev": "tsx src/main.ts serve"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.148.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "silk-wasm": "^3.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "ilink_appid": "bot"
}
