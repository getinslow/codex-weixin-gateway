{
  "stateDir": ".data",
  "weixin": {
    "accountId": "",
    "allowAllUsers": false,
    "allowedUserIds": [],
    "replyOnError": true,
    "longPollTimeoutMs": 35000,
    "typingKeepaliveMs": 5000
  },
  "codex": {
    "backend": "app-server",
    "workingDirectory": ".",
    "projectRoots": [".."],
    "projectAliases": {},
